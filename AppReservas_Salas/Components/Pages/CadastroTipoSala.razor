@using AppReservas_Salas.Models
@using AppReservas_Salas.Controllers
@inject TipoSalaController tipoController
@rendermode InteractiveServer

<div class="modal-header">
    <h5 class="modal-title">Novo Tipo de Sala</h5>
    <button type="button" class="btn-close" @onclick="() => OnClose.InvokeAsync()"></button>
</div>
<div class="modal-body">
    <div class="mb-3">
        <label class="form-label">Nome do Tipo:</label>
        <input class="form-control" @bind="novoTipo.Nome" />
    </div>
</div>
<div class="modal-footer">
    <button class="btn btn-secondary" @onclick="() => OnClose.InvokeAsync()">Cancelar</button>
    <button class="btn btn-primary" @onclick="Salvar">Salvar</button>
</div>

@code {
    private TipoSala novoTipo = new TipoSala();

    [Parameter]
    public EventCallback OnClose { get; set; }

    private async Task Salvar()
    {
        novoTipo.Nome = novoTipo.Nome.Trim();
        novoTipo.Nome = novoTipo.Nome.ToLower();
        await tipoController.Add(novoTipo);
        await tipoController.Salvar();
        await OnClose.InvokeAsync();
    }
}