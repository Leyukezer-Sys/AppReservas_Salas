@using AppReservas_Salas.Models
@using AppReservas_Salas.Controllers
@inject TipoUsuarioController tipoController
@rendermode InteractiveServer

<div class="modal-header">
    <h5 class="modal-title">Novo Tipo de Usuário</h5>
    <button type="button" class="btn-close" @onclick="() => OnClose.InvokeAsync()"></button>
</div>
<div class="modal-body">
    <div class="mb-3">
        <label class="form-label">Nome do Tipo:</label>
        <input class="form-control" @bind="novoTipo.Nome" required/>
    </div>
</div>
<div class="modal-footer">
    <button type="submit" class="btn btn-secondary" @onclick="() => OnClose.InvokeAsync()">Cancelar</button>
    <button class="btn btn-primary" @onclick="SalvarTipo">Salvar</button>
</div>

@code {
    private TipoUsuario novoTipo = new TipoUsuario();

    [Parameter]
    public EventCallback OnClose { get; set; }

    private async Task SalvarTipo()
    {
        await tipoController.Add(novoTipo);
        await tipoController.Salvar();
        await OnClose.InvokeAsync();
    }
}