@page "/login"
@using AppReservas_Salas.Controllers
@using AppReservas_Salas.Models
@using System.Security.Claims
@inject IHttpContextAccessor http;
@using Microsoft.AspNetCore.Authentication;
@inject UsuarioController usuarioController
@layout LoginLayout
@inject NavigationManager navegacao;

@rendermode InteractiveServer

<div class="d-flex flex-row align-items-center justify-content-center" style="height:100vh">
    <div class="col d-flex justify-content-center align-items-center">
        <div class="rounded-2 shadow-lg" style="width: 500px;">
            <div class="d-flex align-items-center justify-content-center mt-3">
                <img class="card-img-top rounded" src="favicon.png" style="width: 50px;"/>
            </div>
            <div class=" mt-3 mx-5 position-relative">
                <label class="form-label" for="txtMatricula">Matricula</label>
                <input type="number"
                       name="txtMatricula"
                       id="txtMatricula"
                       @onchange="VerificarMatricula"
                       class="form-control @(erroMatricula ? "is-invalid" : "")"
                       placeholder=""
                       @ref="matriculaInput" />
                @if (erroMatricula)
                {
                    <div class="invalid-tooltip">
                        As Matricula está Incorreta!
                    </div>
                }
            </div>
            <div class="mt-2 mx-5 position-relative">
                <label class="form-label" for="txtSenha">Senha</label>
                <input type="password"
                       name="txtSenha"
                       id="txtSenha"
                       @onchange="VerificarSenha"
                       class="form-control @(erroSenha ? "is-invalid" : "")"
                       placeholder=""
                       @ref="senhaInput" />
                @if (erroSenha)
                {
                    <div class="invalid-tooltip">
                        As senhas não está Correta para está Matrícula!
                    </div>
                }
            </div>
            <div class="d-flex flex-column align-items-center justify-content-center my-4">
                <button class="btn btn-success fs-4" @onclick="Entrar">ENTRAR</button>
                <a href="/novoUsuario" class="link-info fs-6 mt-2" >Cadastrar-se</a>
            </div>
        </div>       
    </div>
</div>

@code {
    private string? matricula;
    private bool erroMatricula = false;
    private string? senha;
    private bool erroSenha = false;
    private List<Usuario> listaUsuarios = new();
    private ElementReference matriculaInput;
    private ElementReference senhaInput;


    protected override async Task OnInitializedAsync()
    {
        var lista = await usuarioController.Usuarios();
        listaUsuarios = lista;
    }

    public void VerificarMatricula(ChangeEventArgs e)
    {
        matricula = e.Value?.ToString();

        erroMatricula = string.IsNullOrWhiteSpace(matricula);

        if(matricula.Length > 4)
        {
            if (listaUsuarios.Where(u => u.Matricula.Equals(matricula)).ToList().Count < 1)
            {
                erroMatricula = true;
            }
            else erroMatricula = false;
        }

    }

    public void VerificarSenha(ChangeEventArgs e)
    {
        senha = e.Value?.ToString();

        erroSenha = string.IsNullOrWhiteSpace(senha);

        if (listaUsuarios.Where(u => u.Senha.Equals(senha) && u.Matricula.Equals(matricula)).ToList().Count < 1)
        {
            erroSenha = true;
        }
        else erroSenha = false;
    }

    public async Task Entrar()
    {
        if (erroMatricula)
        {
            await matriculaInput.FocusAsync();
            return;
        }

        if (erroSenha)
        {
            await senhaInput.FocusAsync();
            return;
        }

        var usuario = listaUsuarios.FirstOrDefault(u => u.Matricula == matricula && u.Senha == senha);

        if (usuario != null)
        {
            var claims = new List<Claim>
    {
        new Claim(ClaimTypes.Name, usuario.Nome),
        new Claim("Matricula", usuario.Matricula),
        new Claim(ClaimTypes.Role, usuario.Tipo.Nome) 
    };

            var identity = new ClaimsIdentity(claims, "Cookies");
            var principal = new ClaimsPrincipal(identity);

            await http.HttpContext.SignInAsync("Cookies", principal);

            navegacao.NavigateTo("/home");
        }


    }

}
