@inject NavigationManager navegacao;
@inject IHttpContextAccessor http;
@using Microsoft.AspNetCore.Authentication;
@rendermode InteractiveServer

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">Reservas De Salas</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Rerservas de Salas
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="cadastrarSala">
                <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> Cadastrar Sala
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="consultarUsuarios">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Usuarios
            </NavLink>
        </div>
    </nav>
</div>


<div class="position-absolute bottom-0" style="width:100%;">
    <center>
        <button class="btn btn-danger px-lg-5 mb-2" @onclick="Sair">Sair</button>
    </center>
</div>

@code{
    private async Task Sair()
    {
        await http.HttpContext.SignOutAsync("Cookies");
        navegacao.NavigateTo("/login");
    }
}